NEXT_PUBLIC_SITE_URL=https://www.aleksandrapawel-2028.pl
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_WEDDING_SLUG=aleksandra-pawel-2028

# App
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_DEFAULT_PLAN=live
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@aleksandrapawel-2028.pl
INTERNAL_TOOLS_PASSWORD=
NEXT_PUBLIC_INTERNAL_TOOLS_ENABLED=true

# Security
# Set INTERNAL_TOOLS_PASSWORD before exposing /admin publicly.
# API and admin routes have an application-level rate limit; for production add Cloudflare too.
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_MAX_FILES=30
SUPABASE_STORAGE_BUCKET=wedding-media

# Payments are disabled for this private one-wedding app.
PAYMENT_PROVIDER=manual

# Email and monitoring
RESEND_API_KEY=
EMAIL_FROM=Aleksandra i Pawel <onboarding@resend.dev>
SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
