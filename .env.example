# API and internal routes have an application-level rate limit; for production add Vercel Firewall or Cloudflare too.
UPLOAD_MAX_FILE_SIZE_MB=25
UPLOAD_MAX_FILES=30
SUPABASE_STORAGE_BUCKET=wedding-media

# Payments - choose one provider for production
